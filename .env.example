# Copy to .env and replace with your Supabase project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PLATFORM_HOST=rallyhubapp.vercel.app
# Optional — UUID of the RallyHub platform game library org (auto-resolved if omitted)
# VITE_PLATFORM_ORG_ID=
# Optional — for future multi-domain / wildcard (not required on Vercel Hobby)
# VITE_TENANT_HOST=client.rallyhubapp.vercel.app

# Local seed script only (scripts/seed-test-event.mjs) — never commit the real key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SEED_ORGANIZATION_ID=optional-org-uuid
# SEED_APP_ORIGIN=https://rallyhubapp.vercel.app
