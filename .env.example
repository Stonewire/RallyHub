# Copy to .env and replace with your Supabase project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PLATFORM_HOST=rallyhubapp.vercel.app
# Public Cloudflare Turnstile site key for /register. Safe to expose.
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Optional — UUID of the RallyHub platform game library org (auto-resolved if omitted)
# VITE_PLATFORM_ORG_ID=
# Optional — for future multi-domain / wildcard (not required on Vercel Hobby)
# VITE_TENANT_HOST=client.rallyhubapp.vercel.app

# Supabase Edge Function secret for register-client Turnstile verification.
# Set this in Supabase function secrets, not in browser/Vercel public env.
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Paddle billing. Client-side token is public (safe to expose, like the
# Supabase anon key) — set it here and in Vercel. Environment must match the
# token: a "test_..." token is sandbox, a "live_..." token is production.
# VITE_PADDLE_CLIENT_TOKEN=test_your-paddle-client-side-token
# VITE_PADDLE_ENVIRONMENT=sandbox

# Paddle secret API key and webhook signing secret — Supabase Edge Function
# secrets only, never here or in browser/Vercel public env.
# PADDLE_API_KEY=your-paddle-api-key
# PADDLE_WEBHOOK_SECRET=your-paddle-webhook-signing-secret

# Local seed / maintenance scripts — never commit the real key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SEED_ORGANIZATION_ID=optional-org-uuid
# SEED_APP_ORIGIN=https://rallyhubapp.vercel.app

# Repair broken music catalog URLs (scripts/list-catalog-storage.mjs, scripts/repair-music-catalog-urls.mjs)
# Default orgs: 8a0d915f-a5b0-4275-82d6-17ae4d93d55c, 1eb5c173-218e-426c-a9ff-0a41071a7742
